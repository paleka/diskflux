#!/bin/sh
set -e

# The installation failed after the preinst moved the files of
# snapraid-daemon-storage: they go back where they were, last moved first
if [ "$1" = "abort-install" ] && [ -f /run/diskflux-move.list ]; then
    tac /run/diskflux-move.list | while IFS="$(printf '\t')" read -r _from _to; do
        if [ "$_from" = "smb.conf" ]; then
            mv -f "$_to" /etc/samba/smb.conf
        elif [ -e "$_to" ] && [ ! -e "$_from" ]; then
            mv "$_to" "$_from"
        fi
    done
    # the settings exactly as they were before the preinst changed them
    if [ -f /run/diskflux-move.conf ] && [ -f /etc/snapraidd.conf ]; then
        cat /run/diskflux-move.conf > /etc/snapraidd.conf
        touch -r /run/diskflux-move.conf /etc/snapraidd.conf
    fi
    rm -f /run/diskflux-move.conf
    rm -f /run/diskflux-move.list
fi

# Final reload to keep systemd state clean
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
fi

exit 0
