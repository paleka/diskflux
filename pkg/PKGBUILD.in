# Maintainer: Andrea Mazzoleni <amadvance@gmail.com>
pkgname=@PACKAGE@
pkgver=@VERSION@
pkgrel=1
pkgdesc="A background service with a built-in Web UI that automates SnapRAID operations"
arch=('x86_64')
url="https://www.snapraid.it/"
license=('GPL3')
depends=('zlib' 'zstd' 'snapraid>=15.0' 'systemd')
makedepends=('gcc' 'make')
backup=('etc/diskflux.conf')
install="${pkgname}.install"
source=("https://github.com/amadvance/@PACKAGE@/releases/download/v@PACKAGE_VERSION@/@PACKAGE@-@PACKAGE_VERSION@.tar.gz")
sha256sums=('@SHA256@')

build() {
  cd "$pkgname-$pkgver"
  ./configure --prefix=/usr --sysconfdir=/etc --with-init-type=systemd --with-systemdsystemunitdir=/usr/lib/systemd/system
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir/" install
  
  # Add example config and docs
  install -Dm644 diskflux.conf.example "$pkgdir/usr/share/doc/$pkgname/diskflux.conf.example"
  install -m644 diskflux.yaml AUTHORS HISTORY README "$pkgdir/usr/share/doc/$pkgname/"

  # Ensure the config exists in /etc
  install -Dm644 diskflux.conf.example "$pkgdir/etc/diskflux.conf"

  # Arch Policy: License must also be in the license directory
  install -Dm644 LICENSES/GPL-3.0 "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
