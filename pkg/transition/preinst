#!/bin/sh
#
# Before the last snapraid-daemon-storage takes the place of an earlier one.
#
# Copyright (C) 2026 Robert Paleka
# SPDX-License-Identifier: GPL-3.0-or-later
#
# The earlier releases also installed the template service snapraidd@NAME. Its
# instances read /etc/snapraidd-NAME.conf, which DiskFlux doesn't move: they would
# stop working. With one enabled, the update stops here, with nothing changed.

set -e

if [ "$1" = "upgrade" ]; then
	for _l in /etc/systemd/system/*.wants/snapraidd@*.service; do
		[ -L "$_l" ] || continue
		echo "snapraid-daemon-storage: the service $(basename "$_l") is enabled." >&2
		echo "Its array is not moved to DiskFlux. Nothing was changed. Move it to an array of the" >&2
		echo "daemon first (/etc/snapraidd.d, the Arrays page), disable the service, then update again." >&2
		exit 1
	done
fi

exit 0
