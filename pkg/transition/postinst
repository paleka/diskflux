#!/bin/sh
#
# The last snapraid-daemon-storage: start the move to DiskFlux.
#
# Copyright (C) 2026 Robert Paleka
# SPDX-License-Identifier: GPL-3.0-or-later
#
# The daemon of the earlier release keeps running until DiskFlux replaces it.
# DiskFlux is installed once this installation is over, by move-to-diskflux,
# detached from it: as a unit of its own with systemd, else in the background.

set -e

if [ "$1" = "configure" ]; then
	_move=/usr/share/snapraid-daemon-storage/move-to-diskflux
	if [ -d /run/systemd/system ] && command -v systemd-run >/dev/null 2>&1; then
		systemd-run --unit="diskflux-move-$(date +%s)" --no-block "$_move" >/dev/null 2>&1 \
			|| setsid "$_move" >/dev/null 2>&1 < /dev/null &
	else
		setsid "$_move" >/dev/null 2>&1 < /dev/null &
	fi
	echo "DiskFlux takes the place of snapraid-daemon-storage in a moment, keeping its settings."
fi

exit 0
