#!/bin/sh
#
# rc.diskflux: Generic BSD-style init script for the SnapRAID API daemon.
#

# Autoconf placeholders
BIN=@bindir@/diskflux
CONF=@sysconfdir@/diskflux.conf
PIDF=/run/diskflux.pid

# Maximum time to wait for a clean shutdown
STOP_TIMEOUT=60

# Check if the binary is actually executable
if [ ! -x "$BIN" ]; then
    echo "Error: $BIN not found or not executable."
    exit 1
fi

diskflux_start() {
    if [ -f "$PIDF" ]; then
        PID=$(cat "$PIDF")

        # Check if the process is actually running
        if kill -0 "$PID" 2>/dev/null; then
            echo "diskflux is already running (PID: $PID)."
            return 0
        fi

        # Stale PID file found
        rm -f "$PIDF"
    fi

    echo "Starting diskflux..."
    "$BIN" --conf "$CONF"
}

diskflux_stop() {
    if [ ! -f "$PIDF" ]; then
        echo "diskflux is not running."
        return 0
    fi

    PID=$(cat "$PIDF")

    # Stale PID file
    if ! kill -0 "$PID" 2>/dev/null; then
        rm -f "$PIDF"
        echo "diskflux is not running."
        return 0
    fi

    echo "Stopping diskflux (PID: $PID)..."

    if ! kill "$PID"; then
        echo "Error: Failed to stop diskflux (PID: $PID)."
        return 1
    fi

    COUNT=0
    while kill -0 "$PID" 2>/dev/null; do
        if [ "$COUNT" -ge "$STOP_TIMEOUT" ]; then
            echo "Error: diskflux (PID: $PID) did not stop within $STOP_TIMEOUT seconds."
            return 1
        fi

        sleep 1
        COUNT=$((COUNT + 1))
    done

    echo "diskflux stopped."
    return 0
}

diskflux_reload() {
    if [ -f "$PIDF" ]; then
        PID=$(cat "$PIDF")

        if kill -0 "$PID" 2>/dev/null; then
            echo "Reloading diskflux configuration (SIGHUP)..."
            kill -HUP "$PID"
            return
        fi
    fi

    echo "Error: diskflux is not running; cannot reload."
    return 1
}

case "$1" in
    'start')
        diskflux_start
        ;;
    'stop')
        diskflux_stop
        ;;
    'restart')
        diskflux_stop || exit 1
        diskflux_start
        ;;
    'reload')
        diskflux_reload
        ;;
    *)
        echo "usage: $0 {start|stop|restart|reload}"
        exit 1
        ;;
esac
